---
import { business as b, release } from "../data/business";
import ExternalMap from "./ExternalMap.astro";
const base = import.meta.env.BASE_URL;
const live = import.meta.env.RELEASE === "true";
const { showContacts = false } = Astro.props;
---

{
  showContacts && (
    <section
      id="contatti"
      class="contact footer-callout"
      aria-labelledby="contact-title"
    >
      <div class="wrap footer-callout-inner">
        <div>
          <>
            <p class="eyebrow">FACCIAMO DUE PAROLE</p>
            <h2 id="contact-title">
              La tua auto?
              <>
                <br />
                <em>Parliamone.</em>
              </>
            </h2>
          </>
        </div>
        <div class="footer-callout-action">
          <>
            <p>
              Per informazioni sui servizi o per parlare
              <br class="desktop-break" /> della tua auto, chiama l’officina.
            </p>
            <a class="big-phone" href={b.tel}>
              {b.phone} <span aria-hidden="true">↗</span>
            </a>
          </>
        </div>
      </div>
    </section>
  )
}
{
  showContacts && (
    <div class="footer-location">
      <div class="wrap">
        <ExternalMap />
      </div>
    </div>
  )
}
<footer class="site-footer">
  <div class="wrap footer-body">
    <div class:list={["footer-brand", { "with-details": showContacts }]}>
      <div class="footer-identity">
        <a class="wordmark" href={base} aria-label="TurboMastin — Homepage"
          >Turbo<span>Mastin</span></a
        ><p>Ci prendiamo cura del tuo veicolo.</p>
      </div>
      <a
        class="footer-back"
        href={showContacts ? "#contenuto" : `${base}#contatti`}
        >{showContacts ? "Torna su" : "Contatta l’officina"}
        <span aria-hidden="true">{showContacts ? "↑" : "↗"}</span></a
      >
    </div>
    {
      showContacts && (
        <>
          <div class="footer-details">
            <div class="footer-info">
              <>
                <h3>Dove siamo</h3>
                <address>
                  {b.street}
                  <br />
                  {b.locality}
                </address>
                <a
                  class="footer-directions"
                  href={b.directions}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ottieni indicazioni{" "}
                  <>
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (Google Maps, nuova scheda)</span>
                  </>
                </a>
              </>
            </div>
            <div class="footer-info">
              <>
                <h3>I nostri orari</h3>
                <dl class="hours footer-hours">
                  {b.hours.map(([day, time]) => (
                    <div>
                      <dt>{day}</dt>
                      <dd>{time}</dd>
                    </div>
                  ))}
                </dl>
              </>
            </div>
            <div class="footer-info">
              <>
                <h3>Scrivici</h3>
                <a class="footer-email" href={`mailto:${b.email}`}>
                  {b.email}
                </a>
                <br />
                <a
                  class="footer-whatsapp whatsapp-contact"
                  href={b.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <>
                    <span>WhatsApp</span>
                    <span>{b.whatsapp}</span>
                    <span class="sr-only"> (nuova scheda)</span>
                  </>
                </a>
              </>
            </div>
          </div>
        </>
      )
    }
    <div class="footer-legal">
      <div class="footer-policies">
        <a href={`${base}privacy/`}>Privacy e cookie</a><a
          href={`${base}privacy/#cookies`}
          data-consent-open
          data-consent-footer>Preferenze cookie</a
        >
      </div>
      <p class="footer-credit">
        Sito web · <a
          href="https://www.framelabweb.it"
          target="_blank"
          rel="noopener noreferrer"
          >Frame Lab<span class="sr-only"> (nuova scheda)</span></a
        >
      </p>
    </div>
    <p class="footer-note">
      {
        live
          ? `${release.legalName} · ${release.fiscalDetails}`
          : "Anteprima · Dati societari e fiscali da confermare"
      }
    </p>
  </div>
</footer>
<style>
  .site-footer {
    --muted: #465254;
    --line: #b8a785;
    background: #dfd0b2 var(--texture);
    color: var(--ink);
  }
  .footer-location {
    background: var(--paper) var(--texture);
    color: var(--ink);
    padding-block: 32px 30px;
  }
  .footer-callout {
    padding-block: clamp(42px, 5vw, 72px);
  }
  .footer-callout-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 30px 48px;
  }
  .footer-callout .eyebrow {
    margin-bottom: 18px;
  }
  .footer-callout h2 {
    font-size: clamp(38px, 4.7vw, 66px);
    line-height: 1.08;
  }
  .footer-callout-action {
    text-align: right;
  }
  .footer-callout-action p {
    font-size: 13px;
    line-height: 1.8;
    color: #d0cfbe;
  }
  .footer-callout .big-phone {
    font-size: clamp(26px, 3.8vw, 55px);
    gap: 18px;
    padding-top: 14px;
  }
  .footer-body {
    padding-block: 35px 23px;
    border-top: 3px double var(--line);
  }
  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }
  .footer-brand.with-details {
    border-bottom: 3px double var(--line);
    padding-bottom: 25px;
    margin-bottom: 28px;
  }
  .footer-brand .wordmark {
    color: var(--brand);
    font-size: clamp(25px, 2.4vw, 32px);
  }
  .footer-identity p {
    font-size: 12px;
    line-height: 1.8;
    margin-top: 8px;
    color: var(--muted);
  }
  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 32px;
    font-size: 11px;
  }
  .footer-back span {
    font-size: 17px;
  }
  .footer-details {
    display: grid;
    grid-template-columns: 1.05fr 1fr 1.05fr;
    gap: clamp(24px, 3vw, 44px);
  }
  .footer-info {
    min-width: 0;
  }
  .footer-info + .footer-info {
    border-left: 1px solid var(--line);
    padding-left: clamp(20px, 2.3vw, 32px);
  }
  .footer-info h3 {
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  address {
    font-style: normal;
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
  }
  .footer-directions {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 32px;
    font-size: 11px;
    margin-top: 9px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-hours {
    font-size: 13px;
    line-height: 1.9;
    max-width: 275px;
  }
  .footer-hours > div {
    gap: 12px;
    margin-bottom: 8px;
  }
  .footer-email {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .footer-whatsapp {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 10px;
    min-height: 44px;
    border: 1px solid var(--brand);
    background: var(--brand);
    color: var(--paper);
    box-shadow: 3px 3px 0 var(--brass);
    padding: 9px 12px;
    font-size: 11px;
    margin-top: 10px;
  }
  .footer-whatsapp span:not(.sr-only) {
    white-space: nowrap;
  }
  .footer-whatsapp:hover {
    background: var(--brand-dark);
    color: var(--paper);
    box-shadow: 1px 1px 0 var(--brass);
  }
  .footer-location :global(.external-map) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .footer-location :global(.map-heading h3) {
    font-size: 22px;
  }
  .footer-location :global(.map-frame) {
    color: var(--paper);
    border-color: var(--line);
  }
  .footer-location :global(.map-placeholder > .eyebrow) {
    color: #d3c19a;
  }
  .footer-location :global(.map-caption p) {
    color: var(--muted);
  }
  .footer-location :global(.map-preferences) {
    color: var(--brand);
  }
  .footer-location :global(.map-placeholder button:focus-visible) {
    outline-color: var(--brass);
  }
  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    border-top: 1px solid var(--line);
    padding-top: 15px;
    margin-top: 25px;
  }
  .footer-policies {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .footer-policies a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 11px;
  }
  .footer-credit {
    margin: 0;
    font-size: 10px;
    line-height: 1.8;
    color: var(--muted);
  }
  .footer-credit a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-note {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.8;
    margin-top: 8px;
  }
  .footer-back:hover,
  .footer-directions:hover,
  .footer-email:hover,
  .footer-policies a:hover,
  .footer-credit a:hover {
    color: var(--brand-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .footer-callout-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 22px;
    }
    .footer-callout-action {
      text-align: center;
    }
  }
  @media (max-width: 760px) {
    .footer-body {
      padding-block: 28px 22px;
    }
    .footer-details {
      grid-template-columns: 1fr;
      gap: 23px;
    }
    .footer-info + .footer-info {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 22px;
    }
    .footer-info h3 {
      margin-bottom: 12px;
    }
    .footer-legal {
      display: block;
    }
    .footer-credit {
      margin-top: 6px;
    }
  }
</style>
